{
  "name": "belkovy-shef",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --use-env-proxy --env-file-if-exists=.env.local node_modules/vite/bin/vite.js --host 0.0.0.0",
    "build": "vite build && node scripts/build-mobile.js",
    "preview": "vite preview --host 0.0.0.0",
